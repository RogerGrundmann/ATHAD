# Compiled artifacts
*.o
*.d
*.a
*.so
*.so.*

# Python build artifacts
*.pyc
__pycache__/
*.egg-info/
build/
dist/
python/build/

# Cython generated C++
python/pyathad.cpp
python/pyathad.h

# NOTE: the param.py-generated bindings (atmosphere/*.inc, python/atmosphere_pxd.pxi,
# python/pyathad.pyx, cli+python/config_athad.xml) are deliberately TRACKED, as in the
# parent repo — a param.py change then shows its full effect in the diff.

# Simulation output data. The pattern is output_*/ rather than output_Hadean*/
# because an experiment directory named anything else (output_amp100_m1/ and the
# like) then sits untracked-but-not-ignored and shows up in every git status.
# Nothing tracked lives inside an output directory, so the wider pattern is safe.
output_*/
python/output_*/
cli/output_*/
atm_log.txt
atom_log.txt

# Console logs of individual runs. atom_log.txt is RESERVED — the model opens it
# itself and truncates it, so a shell redirect to that name destroys the run's own
# printout; redirect to run_<something>.log instead.
run_*.log

# One-off configs for a particular run length or experiment. The generated
# config_athad.xml in cli/ and python/ stays tracked; these variants do not.
# Convention shared with ATHAD_COND (its 1d41d35) — the underscore is deliberate,
# so the pattern cannot match the two generated files that matter.
config_athad_*.xml

# Executables
cli/had
test/rad_selftest

# Reference papers (copyright)
Reaction_Papers/

# ODT and PDF documents
*.odt
*.pdf

# Claude Code session data
.claude/

# vim/editor swap files
.*.swp

# zeta-scan experiment artefacts (regenerate with python/mkzeta.py)
python/config_zeta_*.xml
python/run_z*.log
python/zeta_scan_status.txt

# H_crit A/B experiment artefacts
python/config_hc*.xml
python/run_hc*.log
python/hcrit*_status.txt
python/config_skin400.xml
python/config_vtkfields.xml
python/vtk_status.txt
python/skin400_status.txt
python/config_prog400.xml
python/prog400_status.txt
python/config_drag_*.xml
python/run_drag_*.log
python/drag_status.txt

# per-run working directories for concurrent A/B arms (see README)
python/run_*/

# Per-run working directories. The output_*/ patterns above catch the model's own
# convention (output_<name>/), but a run driven from its own directory puts the VTK and
# restart files wherever its config says — python/run_foo/out/ does not match output_*.
# One `git add -A` swept 296 million insertions and two 621 MB restart dumps into a commit
# because of that gap; caught before the push, but only just.
python/run*/
run_*/
